reator."],"scoring":"Each signal contributes points to one risk category internally, weighted by its own confidence; category risk is combined into an overall risk with fixed weights and published as trust, 100 minus that risk. See docs/AUDIT_PROTOCOL.md for the full table.","uncertaintyCeiling":65,"weights":[{"category":"contract","description":"Powers the deployed code grants: minting, pausing, deny-lists, mutable fees, upgradeability, privileged balance movement, and whether source is verified.","weight":0.3},{"category":"liquidity","description":"Depth of the discovered pools on the quote side, and whether the provider position is locked or burned.","weight":0.2},{"category":"holder","description":"Concentration of circulating supply across the sampled holders, with pools, burn addresses and the token contract itself excluded.","weight":0.15},{"category":"insider","description":"Wallets that share a funding source, and transfers that fund several recipients at once.","weight":0.1},{"category":"creator","description":"The deployer address and the deployment pattern visible in its sampled history.","weight":0.1},{"category":"trading","description":"Round-trip transfer patterns between the same addresses, and whether the token trades at all.","weight":0.08},{"category":"bot","description":"How much of the earliest distribution a small set of addresses captured.","weight":0.07}]},"notes":[],"observations":{"atBlock":"95489507","balances":{"burned":"0","complete":true,"fromBlock":"0","holderCount":291,"incompleteReason":null,"source":"rpc-logs","toBlock":"95489507","transfersSeen":5874},"bytecode":{"groups":{"blacklist":[],"fee":[],"mint":[],"ownership":[],"pause":[],"restriction":[],"roles":[],"seize":[],"upgrade":[]},"hasDelegateCall":false,"hasSelfDestruct":false,"minimalProxy":false,"selectorCount":25,"size":3248},"clusters":{"clusters":[{"funder":"0x25222d240d5a80267726e48c664237a8569ae736","members":["0x9def5614042109e5b128706c43ae5c0202e2734d","0xf16c5c83ac871